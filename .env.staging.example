# SettleRate — staging client environment template (public Vite variables only)
#
# Copy to a local untracked file if needed for staging builds. Prefer setting
# these in the separate Vercel project `settlerate-app-staging`.
#
# Authority: docs/adr/0008-environment-topology.md
# Secrets map: docs/staging/SECRETS_CONTRACT.md
#
# Do NOT put service-role keys, Stripe secrets, or production values here.

# Staging Supabase project API URL
VITE_SUPABASE_URL=https://gkhbalfpxjtleypbabjo.supabase.co

# Staging anon / publishable key (fill from staging project API settings)
VITE_SUPABASE_PUBLISHABLE_KEY=

# Required for staging builds — must be an approved staging origin (exact match).
# Preferred custom domain (when DNS exists):
VITE_APP_ORIGIN=https://staging.settlerate.com

# Optional. Staging Sentry DSN only — never the production DSN.
VITE_SENTRY_DSN=
