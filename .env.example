# SettleRate — local client environment (public Vite variables only)
#
# Copy this file to `.env` and fill in values for your Supabase project:
#   cp .env.example .env
#
# These are public client configuration (safe to expose in the browser bundle).
# Do NOT put service-role keys, Stripe secrets, or other server secrets here.
# Server secrets belong in Supabase Edge Function secrets / platform config.
#
# Authority: docs/adr/0002-secrets-and-environment-policy.md

# Supabase project API URL (https://<project-ref>.supabase.co)
VITE_SUPABASE_URL=

# Supabase anon / publishable key (role: anon)
VITE_SUPABASE_PUBLISHABLE_KEY=
