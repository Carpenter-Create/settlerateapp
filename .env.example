# SettleRate — local client environment (public Vite variables only)
#
# Copy this file to `.env` and fill in values for your Supabase project:
#   cp .env.example .env
#
# These are public client configuration (safe to expose in the browser bundle).
# Do NOT put service-role keys, Stripe secrets, or other server secrets here.
# Server secrets belong in Supabase Edge Function secrets / platform config.
#
# Authority: docs/adr/0002-secrets-and-environment-policy.md

# Supabase project API URL (https://<project-ref>.supabase.co)
VITE_SUPABASE_URL=

# Supabase anon / publishable key (role: anon)
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional. Override for the Supabase Auth email redirect origin (signup
# confirmation, magic-link login, password reset). Leave unset to use the
# production default (https://app.settlerate.com). Only these exact values
# are accepted; anything else falls back to the production default — see
# src/lib/authRedirect.ts and docs/adr/0008-environment-topology.md.
#   https://staging.settlerate.com
#   http://localhost:5173
#   http://localhost:8080
#   http://127.0.0.1:5173
#   http://127.0.0.1:8080
# Staging builds should use .env.staging.example / Vercel staging env.
VITE_APP_ORIGIN=

# Optional. Sentry client DSN (public identifier, safe to expose in the
# browser bundle — not a secret). Leave unset to keep observability
# disabled; observability is inert without it and also never active outside
# a production build, so local development never sends events either way.
# Authority: docs/adr/0003-observability-policy.md
VITE_SENTRY_DSN=
